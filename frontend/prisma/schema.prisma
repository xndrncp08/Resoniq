// Resoniq database schema
// Auth models follow the shape NextAuth's Prisma adapter expects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set for email/password signups, null for OAuth-only users
  createdAt     DateTime  @default(now())

  // Public identity. The DB fills a random handle; a check constraint enforces ^[a-z0-9_]{3,30}$.
  handle         String        @unique @default(dbgenerated("('u_'::text || substr(md5(((random())::text || (clock_timestamp())::text)), 1, 10))"))
  bio            String?
  instruments    String[]      @default([])
  genres         String[]      @default([])
  links          Json?
  role           Role          @default(USER)
  status         AccountStatus @default(ACTIVE)
  suspendedUntil DateTime?
  statusReason   String?
  reputation     Int           @default(0)
  followerCount  Int           @default(0)
  followingCount Int           @default(0)

  accounts  Account[]
  sessions  Session[]
  tones     Tone[]
  songs     Song[]
  followers Follow[]   @relation("following")
  following Follow[]   @relation("follower")
  auditLogs AuditLog[]

  posts              Post[]
  comments           Comment[]
  postVotes          PostVote[]
  commentVotes       CommentVote[]
  bookmarks          Bookmark[]
  memberships        CommunityMember[]
  communitiesCreated Community[]
  notifications      Notification[]    @relation("recipient")
  notificationsSent  Notification[]    @relation("actor")
  reports            Report[]          @relation("reporter")
  reportsResolved    Report[]          @relation("resolver")
  appeals            Appeal[]          @relation("appellant")
  appealsDecided     Appeal[]          @relation("decider")
  gearSubmitted      GearItem[]
  toneSaves          ToneSave[]
  media              Media[]

  // Profile banner, served from /api/media (avatars reuse `image`).
  bannerUrl        String?
  // The avatars someone can switch back to: their last processed upload and
  // the photo of the Google account they sign in with. `image` is what shows.
  uploadedImage    String?
  providerImage    String?
  // Portfolio (lib/portfolio.ts): where they play, what they're open to, who shaped
  // their sound, and the post and tone they lead with. Pins must be their own.
  location         String?
  openTo           String[]             @default([])
  influences       String[]             @default([])
  pinnedPostId     String?
  signatureToneId  String?
  pinnedPost       Post?                @relation("pinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)
  signatureTone    Tone?                @relation("signatureTone", fields: [signatureToneId], references: [id], onDelete: SetNull)
  rig              UserGear[]
  // Collaboration details (lib/portfolio.ts): until when they're taking on sessions, since when they play, a few highlights.
  availableUntil   DateTime?
  availabilityNote String?
  playingSince     Int?
  highlights       String[]             @default([])
  // Who may start a conversation with them (lib/messaging.ts).
  dmPolicy         DmPolicy             @default(EVERYONE)
  conversations    ConversationMember[]
  messages         Message[]
  reactions        MessageReaction[]
  blocking         Block[]              @relation("blocker")
  blockedBy        Block[]              @relation("blocked")
  // Bumped on password reset: every JWT minted before it stops working (lib/authz.ts).
  sessionVersion   Int                  @default(0)

  // SYSTEM rows are reserved publishing identities (lib/system-identity.ts): no
  // credentials, never signed in, never staff (check constraint User_system_not_staff).
  kind UserKind @default(PERSON)

  toneDraftsReviewed ToneDraft[]
  managedCreator     ManagedCreator?
  practicePassages   PracticePassage[]
  setlists           Setlist[]
  riffs              Riff[]

  @@index([pinnedPostId])
  @@index([signatureToneId])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserKind {
  PERSON
  SYSTEM
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

// Every privileged action. actorId is null for CLI/system actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  reason     String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A tone. Two independent sources, never mixed:
//   data — what Resoniq's analysis INFERRED (StoredToneData, lib/tone-recipe.ts); null for hand-built tones.
//   rig  — what the creator DECLARED about their real setup (RigSpec, types/rig.ts); optional.
// UNLISTED (the default, and every pre-existing tone) is viewable by link only; PUBLIC is listed
// on profiles and discovery, and only ever set by the owner.
model Tone {
  id           String         @id @default(cuid())
  userId       String
  songId       String?
  name         String
  data         Json?
  rig          Json?
  description  String?
  visibility   ToneVisibility @default(UNLISTED)
  // Set when the creator changed the inferred recipe's knobs after analysis.
  recipeEdited Boolean        @default(false)
  remixOfId    String?
  favorite     Boolean        @default(false)
  saveCount    Int            @default(0)
  remixCount   Int            @default(0)
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  // Who wrote it: a member, or Resoniq's preset library.
  origin       ToneOrigin     @default(MEMBER)
  // Legacy anonymous attribution; managed creators use their labelled profile.
  anonymous    Boolean        @default(false)

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  remixOf     Tone?      @relation("remix", fields: [remixOfId], references: [id], onDelete: SetNull)
  remixes     Tone[]     @relation("remix")
  posts       Post[]
  signatureOf User[]     @relation("signatureTone")
  gear        ToneGear[]
  saves       ToneSave[]
  draft       ToneDraft?
  riffs       Riff[]

  @@index([userId, favorite, createdAt])
  @@index([visibility, publishedAt])
  @@index([visibility, saveCount])
  @@index([visibility, createdAt(sort: Desc), id(sort: Desc)])
  @@index([visibility, saveCount(sort: Desc), id(sort: Desc)])
  @@index([remixOfId])
  @@index([origin, visibility, createdAt])
}

enum ToneVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ToneOrigin {
  MEMBER
  GENERATED
}

enum ToneDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  FAILED
  UNPUBLISHED
}

/// A Resoniq-generated preset awaiting review (lib/tone-drafts.ts). Publishing
/// copies it into a public Tone owned by a Resoniq-managed creator.
model ToneDraft {
  id           String          @id @default(cuid())
  // Preset key from lib/tone-presets.ts; generating the same preset twice is a no-op.
  key          String          @unique
  // Hash of the normalized rig settings: catches duplicate content under another name/key.
  fingerprint  String          @unique
  status       ToneDraftStatus @default(DRAFT)
  name         String
  description  String
  instrument   String
  genres       String[]        @default([])
  rig          Json
  scheduledFor DateTime?
  toneId       String?         @unique
  error        String?
  reviewedById String?
  reviewedAt   DateTime?
  publishedAt  DateTime?
  creatorId    String?
  communityId  String?
  postId       String?         @unique
  removedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  tone       Tone?                 @relation(fields: [toneId], references: [id], onDelete: SetNull)
  reviewedBy User?                 @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  creator    ManagedCreator?       @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  community  Community?            @relation(fields: [communityId], references: [id], onDelete: Restrict)
  post       Post?                 @relation(fields: [postId], references: [id], onDelete: SetNull)
  events     TonePublishingEvent[]

  @@index([status, scheduledFor])
  @@index([creatorId])
  @@index([communityId])
  @@index([reviewedById])
}

/// Resoniq owns these non-login publishing identities. No member accounts are converted.
model ManagedCreator {
  id             String      @id @default(cuid())
  userId         String      @unique
  owner          String      @default("Resoniq")
  specialization String
  enabled        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  drafts         ToneDraft[]
}

model TonePublishingControl {
  id              String    @id @default("default")
  paused          Boolean   @default(true)
  initialImportAt DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt
}

/// Append-only publication attempts survive unpublishing and tone removal.
model TonePublishingEvent {
  id        String    @id @default(cuid())
  draftId   String
  action    String
  source    String
  toneId    String?
  error     String?
  createdAt DateTime  @default(now())
  draft     ToneDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([source, action, createdAt])
  @@index([draftId, createdAt])
}

enum GearKind {
  GUITAR
  BASS
  PICKUP
  AMP
  CAB
  PEDAL
  MULTIFX
  MODELER
  PLUGIN
}

enum GearStatus {
  APPROVED
  PENDING
  REJECTED
}

// The shared gear catalog. Creators can also name custom gear inline in a rig
// without it ever entering the catalog; submissions arrive PENDING.
model GearItem {
  id          String     @id @default(cuid())
  slug        String     @unique
  kind        GearKind
  brand       String
  model       String
  description String?
  // Control names, e.g. ["Gain","Bass","Middle","Treble","Presence","Master"].
  controls    String[]   @default([])
  status      GearStatus @default(APPROVED)
  createdById String?
  createdAt   DateTime   @default(now())

  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tones     ToneGear[]
  owners    UserGear[]

  @@index([kind, status])
  @@index([status, createdAt])
  @@index([createdById])
}

model ToneGear {
  toneId     String
  gearItemId String

  tone Tone     @relation(fields: [toneId], references: [id], onDelete: Cascade)
  gear GearItem @relation(fields: [gearItemId], references: [id], onDelete: Cascade)

  @@id([toneId, gearItemId])
  @@index([gearItemId])
}

// The gear on a musician's profile, in the order they list it.
model UserGear {
  userId     String
  gearItemId String
  note       String?
  position   Int
  createdAt  DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gear GearItem @relation(fields: [gearItemId], references: [id], onDelete: Cascade)

  @@id([userId, gearItemId])
  @@index([gearItemId])
}

model ToneSave {
  userId    String
  toneId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tone Tone @relation(fields: [toneId], references: [id], onDelete: Cascade)

  @@id([userId, toneId])
  @@index([userId, createdAt])
  @@index([toneId])
}

// An uploaded track and its analysis job: status moves
// UPLOADED -> ANALYZING -> ANALYZED | FAILED (see /api/analyze).
model Song {
  id                String     @id @default(cuid())
  userId            String
  title             String?
  artist            String?
  // Legacy public URL (uploads before private storage). New uploads leave
  // it null and set storageKey; audio is served by /api/songs/[id]/audio.
  fileUrl           String?
  storageKey        String?
  durationSec       Float?
  sourceType        SourceType @default(UPLOAD)
  sourceUrl         String?
  status            SongStatus @default(UPLOADED)
  analysisData      Json?
  analysisError     String?
  // When the current analysis was claimed; lets a stuck ANALYZING job be retried.
  analysisStartedAt DateTime?
  createdAt         DateTime   @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media?

  @@index([userId])
}

enum SourceType {
  UPLOAD
  LINK
}

enum SongStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  FAILED
}

// Durable background work, claimed by the worker service with FOR UPDATE SKIP LOCKED (lib/jobs/queue.ts).
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
  @@index([type, status])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// ── Social ─────────────────────────────────────────────────────────────

enum CommunityKind {
  GENRE
  INSTRUMENT
  GEAR
  STYLE
  TOPIC
}

model Community {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @default("")
  kind        CommunityKind @default(TOPIC)
  // [{ title, body }] shown on the community page and to moderators.
  rules       Json?
  memberCount Int           @default(0)
  postCount   Int           @default(0)
  createdById String?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())

  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members    CommunityMember[]
  posts      Post[]
  toneDrafts ToneDraft[]

  @@index([memberCount])
  @@index([createdById, createdAt])
}

enum CommunityRole {
  MEMBER
  MODERATOR
}

model CommunityMember {
  userId      String
  communityId String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([communityId, role])
}

enum PostCategory {
  DISCUSSION
  QUESTION
  PERFORMANCE
  COVER
  GEAR_DEMO
  TONE_COMPARISON
  TUTORIAL
  PEDALBOARD
}

// PROCESSING: waiting on media. HELD: automod or report threshold, visible to the author and staff only.
enum ContentStatus {
  PUBLISHED
  PROCESSING
  HELD
  REMOVED
  DELETED
}

model Post {
  toneDraft     ToneDraft?
  id            String        @id @default(cuid())
  authorId      String
  communityId   String?
  category      PostCategory  @default(DISCUSSION)
  title         String?
  body          String        @default("")
  toneId        String?
  status        ContentStatus @default(PUBLISHED)
  removedReason String?
  heldReasons   String[]      @default([])
  score         Int           @default(0)
  upCount       Int           @default(0)
  commentCount  Int           @default(0)
  bookmarkCount Int           @default(0)
  // Stored hot rank (lib/ranking.ts): monotonic in time, so it can be indexed.
  hotRank       Float         @default(0)
  createdAt     DateTime      @default(now())
  editedAt      DateTime?

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  tone      Tone?      @relation(fields: [toneId], references: [id], onDelete: SetNull)
  tags      PostTag[]
  comments  Comment[]
  votes     PostVote[]
  bookmarks Bookmark[]
  media     Media[]
  pinnedBy  User[]     @relation("pinnedPost")

  @@index([status, hotRank, id])
  @@index([hotRank(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt, id])
  @@index([communityId, status, hotRank])
  @@index([communityId, status, createdAt])
  @@index([authorId, createdAt])
  @@index([toneId])
}

model PostTag {
  postId    String
  tag       String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, tag])
  @@index([tag, createdAt])
}

model Comment {
  id            String        @id @default(cuid())
  postId        String
  authorId      String
  parentId      String?
  depth         Int           @default(0)
  body          String
  status        ContentStatus @default(PUBLISHED)
  removedReason String?
  score         Int           @default(0)
  replyCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  editedAt      DateTime?

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("thread")
  votes   CommentVote[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model PostVote {
  userId    String
  postId    String
  value     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model CommentVote {
  userId    String
  commentId String
  value     Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model Bookmark {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

enum NotificationType {
  FOLLOW
  MENTION
  COMMENT
  REPLY
  TONE_SAVE
  TONE_REMIX
  MODERATION
  ANNOUNCEMENT
  MEDIA_READY
  MEDIA_FAILED
  COLLAB_INVITE
  COLLAB_ACCEPTED
  PROJECT_ADDED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  actorId   String?
  postId    String?
  commentId String?
  toneId    String?
  // Small display payload (e.g. moderation reason, announcement title). Never trusted as HTML.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([actorId])
}

enum ReportTarget {
  POST
  COMMENT
  USER
  MEDIA
  COMMUNITY
  TONE
  MESSAGE
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  NSFW
  VIOLENCE
  COPYRIGHT
  IMPERSONATION
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   ReportTarget
  targetId     String
  reason       ReportReason
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  reporter   User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId, status])
  @@index([reporterId, targetType, targetId])
  @@index([resolvedById])
}

enum AppealTarget {
  POST
  COMMENT
  ACCOUNT
  MEDIA
}

enum AppealStatus {
  OPEN
  UPHELD
  REVERSED
}

model Appeal {
  id           String       @id @default(cuid())
  userId       String
  targetType   AppealTarget
  targetId     String
  body         String
  status       AppealStatus @default(OPEN)
  decidedById  String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime     @default(now())

  user      User  @relation("appellant", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("decider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, targetType, targetId])
  @@index([decidedById])
}

enum ModerationRuleKind {
  BLOCKED_TERM
  LINK_HOLD_NEW_ACCOUNTS
  MAX_MENTIONS
  REPORT_HOLD
}

// Automated moderation policy, edited in the admin console. `config` shape depends on kind (lib/automod.ts).
model ModerationRule {
  id        String             @id @default(cuid())
  kind      ModerationRuleKind
  label     String
  config    Json
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean
  description String   @default("")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ── Media ──────────────────────────────────────────────────────────────

enum MediaKind {
  VIDEO
  AUDIO
  IMAGE
}

enum MediaPurpose {
  POST
  AVATAR
  BANNER
  MESSAGE
}

// UPLOADING → PROCESSING (worker) → READY | FAILED. REMOVED by moderation or the owner;
// its files are purged by a delayed media.purge job so a reversed appeal can restore them.
enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  REMOVED
}

model Media {
  id            String       @id @default(cuid())
  ownerId       String
  postId        String?
  purpose       MediaPurpose @default(POST)
  position      Int          @default(0)
  kind          MediaKind
  status        MediaStatus  @default(UPLOADING)
  mime          String
  // Declared at upload start, then replaced by the stored size.
  sizeBytes     Int
  originalKey   String
  playbackKey   String?
  posterKey     String?
  previewKey    String?
  peaksKey      String?
  width         Int?
  height        Int?
  durationSec   Float?
  alt           String?
  // The audio track, extracted as a Song so the analysis engine can infer its tone.
  songId        String?      @unique
  error         String?
  removedReason String?
  removedAt     DateTime?
  readyAt       DateTime?
  createdAt     DateTime     @default(now())

  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  song      Song?    @relation(fields: [songId], references: [id], onDelete: SetNull)
  // Attached to a private message instead of a post (purpose MESSAGE); visible to that conversation's members.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([postId, position])
  @@index([status, createdAt])
  @@index([messageId])
}

// ── Platform operations (admin console) ──────────────────────────────

enum FeaturedPlacement {
  LANDING
  HOME
  EXPLORE
}

enum FeaturedKind {
  POST
  TONE
  USER
  COMMUNITY
}

// Staff curation. Rendered only while the target is still visible to the viewer.
model FeaturedSlot {
  id          String            @id @default(cuid())
  placement   FeaturedPlacement
  kind        FeaturedKind
  targetId    String
  position    Int               @default(0)
  note        String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([placement, position])
}

enum AnnouncementLevel {
  INFO
  WARN
}

model Announcement {
  id          String            @id @default(cuid())
  title       String
  body        String            @default("")
  level       AnnouncementLevel @default(INFO)
  startsAt    DateTime          @default(now())
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([startsAt, endsAt])
}

// Shared fixed-window rate-limit counters, used when the app runs on several
// instances (serverless). Times are epoch milliseconds to stay clear of
// timestamp time-zone conversions. See lib/rate-limit.ts.
model RateLimitBucket {
  id      String @id
  count   Int
  resetAt BigInt

  @@index([resetAt])
}

// Tempo ladder: a passage a musician is working up, and the tempos they've
// played it at. Private to its owner; deleted with the account.
model PracticePassage {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  targetBpm Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  takes     PracticeTake[]

  @@index([userId, updatedAt(sort: Desc)])
}

model PracticeTake {
  id        String          @id @default(cuid())
  passageId String
  passage   PracticePassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  bpm       Int
  // false: "not clean yet" at this tempo. Both are progress worth seeing.
  clean     Boolean
  createdAt DateTime        @default(now())

  @@index([passageId, createdAt])
}

// ── Messaging and collaboration (lib/messaging.ts) ─────────────────────

enum DmPolicy {
  EVERYONE
  FOLLOWING
  NOBODY
}

// DIRECT: two people (directKey dedupes them). PROJECT: a named shared space for a collaboration.
enum ConversationKind {
  DIRECT
  PROJECT
}

model Conversation {
  id                  String           @id @default(cuid())
  kind                ConversationKind @default(DIRECT)
  // "<smaller user id>:<larger user id>" for DIRECT, so two people share one thread.
  directKey           String?          @unique
  title               String?
  brief               String?
  createdById         String?
  createdAt           DateTime         @default(now())
  lastMessageAt       DateTime         @default(now())
  lastMessageAuthorId String?

  members  ConversationMember[]
  messages Message[]
  riffs    Riff[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  // Left a project: keeps their history attributed but stops access and updates.
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt])
}

enum MessageKind {
  TEXT
  // A structured request to collaborate; `invite` holds what, when and where, `inviteStatus` the answer.
  COLLAB_INVITE
  // Written by Resoniq: someone joined, a project started.
  SYSTEM
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  authorId       String
  kind           MessageKind   @default(TEXT)
  body           String        @default("")
  replyToId      String?
  invite         Json?
  inviteStatus   InviteStatus?
  // Set when an accepted invite started a project.
  projectId      String?
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("replies")
  reactions    MessageReaction[]
  media        Media[]

  @@index([conversationId, createdAt])
  @@index([authorId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([userId])
}

// Blocking hides each person from the other's messages and stops new conversations either way.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// A gig's setlist. Songs live in `items` (validated JSON: title, BPM, key, tone, MIDI program, notes) so reordering is one write.
model Setlist {
  id        String    @id @default(cuid())
  userId    String
  name      String
  venue     String?
  date      DateTime?
  notes     String?
  items     Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

enum RiffStage {
  IDEA
  DEVELOPING
  READY
  ARCHIVED
}

/// Riff Vault: a musical idea and its recorded takes. Private to the owner unless shared into a project.
model Riff {
  id        String    @id @default(cuid())
  ownerId   String
  title     String
  notes     String?
  tags      String[]  @default([])
  key       String?
  bpm       Int?
  stage     RiffStage @default(IDEA)
  pinned    Boolean   @default(false)
  toneId    String?
  // A collaboration project (a PROJECT conversation) whose members may listen.
  projectId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tone    Tone?         @relation(fields: [toneId], references: [id], onDelete: SetNull)
  project Conversation? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  takes   RiffTake[]

  @@index([ownerId, pinned, updatedAt])
  @@index([projectId])
  @@index([toneId])
}

enum RiffTakeStatus {
  UPLOADING
  READY
}

/// One recording of a riff, stored as uploaded (browser recordings play natively; no transcoding worker needed).
model RiffTake {
  id          String         @id @default(cuid())
  riffId      String
  ownerId     String
  label       String?
  storageKey  String
  mime        String
  sizeBytes   Int
  durationSec Float?
  // ~120 normalised peak values for the waveform preview, computed in the browser.
  peaks       Json?
  status      RiffTakeStatus @default(UPLOADING)
  createdAt   DateTime       @default(now())

  riff Riff @relation(fields: [riffId], references: [id], onDelete: Cascade)

  @@index([riffId, createdAt])
  @@index([ownerId, createdAt])
}
