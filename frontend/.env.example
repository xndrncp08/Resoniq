# Database
DATABASE_URL="postgresql://resoniq:resoniq@localhost:5432/resoniq"

# NextAuth v5
AUTH_SECRET="generate-with: npx auth secret"
# Production (`next start`) only: Auth.js rejects requests from hosts it
# doesn't trust. Set the public URL, or trust the Host header when a proxy
# you control sets it. `next dev` trusts localhost on its own.
# AUTH_URL="https://resoniq.example.com"
# AUTH_TRUST_HOST="true"

# Google OAuth (optional; the button only appears when both are set).
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (verification and password reset) via Resend's HTTP API. Unset in
# development, emails are printed to the server log instead; unset in
# production, they're dropped (and logged as an error).
RESEND_API_KEY=""
RESONIQ_EMAIL_FROM=""   # e.g. "Resoniq <hello@your-domain>"

# Song and media storage. With SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY set, uploads go
# to a *private* Supabase bucket named "songs"; otherwise to local disk under
# RESONIQ_LOCAL_STORAGE_DIR (default ./.storage). RESONIQ_STORAGE forces one.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# RESONIQ_STORAGE="local"
# RESONIQ_LOCAL_STORAGE_DIR=".storage"
# With Supabase, media uses the same private bucket and is served through
# 5-minute signed URLs; uploads go straight from the browser to the bucket.

# Worker (npx tsx worker/index.ts): ffmpeg/ffprobe on PATH, or point at them.
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"

# Tests only. Integration tests truncate every table, so this must be a
# throwaway database whose name ends in _test.
# TEST_DATABASE_URL="postgresql://resoniq:resoniq@localhost:5432/resoniq_test"

# Analysis engine. RESONIQ_ENGINE_SECRET must match the engine's value
# (generate with: openssl rand -hex 32).
PYTHON_ENGINE_URL="http://localhost:8000"
RESONIQ_ENGINE_SECRET=""
