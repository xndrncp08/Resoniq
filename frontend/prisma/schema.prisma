// Resoniq database schema
// Auth models follow the shape NextAuth's Prisma adapter expects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // set for email/password signups, null for OAuth-only users
  createdAt     DateTime  @default(now())

  // Public identity. The DB fills a random handle; a check constraint enforces ^[a-z0-9_]{3,30}$.
  handle         String        @unique @default(dbgenerated("('u_'::text || substr(md5(((random())::text || (clock_timestamp())::text)), 1, 10))"))
  bio            String?
  instruments    String[]      @default([])
  genres         String[]      @default([])
  links          Json?
  role           Role          @default(USER)
  status         AccountStatus @default(ACTIVE)
  suspendedUntil DateTime?
  statusReason   String?
  reputation     Int           @default(0)
  followerCount  Int           @default(0)
  followingCount Int           @default(0)

  accounts  Account[]
  sessions  Session[]
  tones     Tone[]
  songs     Song[]
  followers Follow[]   @relation("following")
  following Follow[]   @relation("follower")
  auditLogs AuditLog[]
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

// Every privileged action. actorId is null for CLI/system actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  reason     String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A saved tone recipe. `data` holds StoredToneData (lib/tone-recipe.ts).
// Anyone with the id can view it at /t/[id]; see SECURITY.md.
model Tone {
  id        String   @id @default(cuid())
  userId    String
  songId    String?
  name      String
  data      Json
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, favorite, createdAt])
}

// An uploaded track and its analysis job: status moves
// UPLOADED -> ANALYZING -> ANALYZED | FAILED (see /api/analyze).
model Song {
  id           String     @id @default(cuid())
  userId       String
  title        String?
  artist       String?
  // Legacy public URL (uploads before private storage). New uploads leave
  // it null and set storageKey; audio is served by /api/songs/[id]/audio.
  fileUrl      String?
  storageKey   String?
  durationSec  Float?
  sourceType   SourceType @default(UPLOAD)
  sourceUrl    String?
  status       SongStatus @default(UPLOADED)
  analysisData Json?
  analysisError String?
  // When the current analysis was claimed; lets a stuck ANALYZING job be retried.
  analysisStartedAt DateTime?
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SourceType {
  UPLOAD
  LINK
}

enum SongStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  FAILED
}

 
// Durable background work, claimed by the worker service with FOR UPDATE SKIP LOCKED (lib/jobs/queue.ts).
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
  @@index([type, status])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}
