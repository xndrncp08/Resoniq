# Required: every /analyze call must send this in X-Resoniq-Engine-Key.
RESONIQ_ENGINE_SECRET=""
# Optional
RESONIQ_MAX_AUDIO_SECONDS="600"
# Comma-separated hosts the URL form of /analyze may fetch from (unset = any public host).
RESONIQ_AUDIO_URL_ALLOWED_HOSTS=""
ANTHROPIC_API_KEY=""
RESONIQ_CLAUDE_MODEL="claude-sonnet-5"
