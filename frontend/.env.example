# Database
DATABASE_URL="postgresql://resoniq:resoniq@localhost:5432/resoniq"

# NextAuth v5
AUTH_SECRET="generate-with: npx auth secret"

# Google OAuth (optional; the button only appears when both are set).
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Song storage. With SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY set, uploads go
# to a *private* Supabase bucket named "songs"; otherwise to local disk under
# RESONIQ_LOCAL_STORAGE_DIR (default ./.storage). RESONIQ_STORAGE forces one.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# RESONIQ_STORAGE="local"
# RESONIQ_LOCAL_STORAGE_DIR=".storage"

# Analysis engine. RESONIQ_ENGINE_SECRET must match the engine's value
# (generate with: openssl rand -hex 32).
PYTHON_ENGINE_URL="http://localhost:8000"
RESONIQ_ENGINE_SECRET=""
